#!/bin/bash

# Launch LOTRO client from CLI.
#
# To be used
#  - with cygwin on windows if you just can't stand .NET
#  - or with wine/cedega under GNU/Linux or *BSD
# to play The Lord of the Rings Online.
#
# URL-encoding is necessary, so get urlencode.sh from the net,
#  eg. from http://www.shelldorado.com/scripts/cmds/urlencode.txt
#
# CopyLeft (C) 2007-2014 SNy <SNy@SNy.name>
#

########### SETUP

# options for wget etc. and for starting the game, add everything you need here
wgetOptions="--no-check-certificate -q"
# if you find that connections to Turbine's servers hang, try forcing SSLv3
#wgetOptions="--no-check-certificate -q --secure-protocol=SSLv3"

export WINEDEBUG="fixme-all"
export WINEPREFIX="$HOME/.wine-lotro/" # CHANGE THIS as appropriate!

# directory for storing temporary files (allows to keep multiple accounts separate with different launchers)
tempDir=".launcher/"

# use 32bit or 64bit wine (not used for patching, see below)
wineBinary=wine64

# fullscreen 1680x1050 on pseudo-desktop with alt-tab ability
wineOptions="explorer /desktop=LotRO,1680x1050"

# glc - OpenGL/ALSA capturing
#preWineCmds="glc-capture --fps=25 -v 4 --pbo --out=/some/path/to/your/liking/lotro-capture-%year%-%month%-%day%-%capture%.glc"

# extra paths needed for glc:i386
#export PATH="${PATH}:/usr/bin"
#export LD_LIBRARY_PATH="${LD_LIBRARY_PATH}:/usr/lib:/usr/lib/x86_64-linux-gnu"


########### START

echo -e "\nWelcome to the CLI launcher for LOTRO v1.2.1.\n\t(C) 2007-2016 by SNy\n"

# official launcher config file
configFile="TurbineLauncher.exe.config"

# make this script be callable from elsewhere (desktop shortcuts etc)
# change directory to where the launcher resides
oldDir=`pwd`
gameDir=`dirname "$0"`
cd "$gameDir"
mkdir -p ${tempDir}

# launcher config file starts it all, get Game and DataCenter settings
if ! [[ -s $configFile ]] ; then
    echo -e "\nError: $configFile cannot be read.\n"
    cd "$oldDir"
    read dummy
    exit
fi

echo "Reading launcher configuration..."
glsDataCenter_URL=`grep -h "Launcher.DataCenterService.GLS" $configFile | grep -v '<!--.*-->' | sed -e "s/^.*value=\"\([^\"]*\)\".*$/\1/"`
game=`grep -h "DataCenter.GameName" $configFile | grep -v '<!--.*-->' | sed -e "s/^.*value=\"\([^\"]*\)\".*$/\1/"`

# get configuration info (xml-file containing auth, patch and game servers with their corresponding settings)
# NOTE: while a normal HTTP GET to /GLS.DataCenterServer/Service.asmx/GetDatacenters?game=LOTROEU
#       works fine for the european datacenter, it does not work for the US/AU/... LOTRO one
#       instead, we need to send a SOAP request there, ending up with a SOAP answer (no whitespace whatsoever)
#       now, to have at least some whitespace we can deal with, sed is used to insert a newline after each closing xml tag below
wget $wgetOptions \
    --header 'Content-Type: text/xml; charset=utf-8' \
    --header 'SOAPAction: "http://www.turbine.com/SE/GLS/GetDatacenters"' \
    --post-data "<?xml version=\"1.0\" encoding=\"utf-8\"?><soap:Envelope xmlns:soap=\"http://schemas.xmlsoap.org/soap/envelope/\" xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\" xmlns:xsd=\"http://www.w3.org/2001/XMLSchema\"><soap:Body><GetDatacenters xmlns=\"http://www.turbine.com/SE/GLS\"><game>${game}</game></GetDatacenters></soap:Body></soap:Envelope>" \
    "${glsDataCenter_URL}" -O ${tempDir}/GLSDataCenter.config
if ! [[ -s ${tempDir}/GLSDataCenter.config ]] ; then
    echo -e "\nError: Could not fetch GLS data center configuration.\n"
    cd "$oldDir"
    read dummy
    exit
fi
# insert the whitespace after closing xml tags here
sed -e "s#\(</[^>]*>\)#\1\n#g" -i ${tempDir}/GLSDataCenter.config
# skip all datacenters but the one we are adressing
# precaution as the DDO datacenter config contains more than one <Datacenter> section which breaks things
echo -e "<!--\n  NOTE\n  This file is NOT a valid XML file!\n-->" > ${tempDir}/GLSDataCenter.config.${game}
cat ${tempDir}/GLSDataCenter.config | sed -n -e "/^.*<Datacenter><Name>${game}<\/Name>/,/<\/Datacenter>.*$/ p" >> ${tempDir}/GLSDataCenter.config.${game}

# get dynamic launcher settings
patchServer_ADR=`grep -h "<PatchServer>" ${tempDir}/GLSDataCenter.config.${game} | grep -v '<!--.*-->' | sed -e "s/^.*<PatchServer>//;s/<\/PatchServer>.*$//"`
launcherCfg_URL=`grep -h "<LauncherConfigurationServer>" ${tempDir}/GLSDataCenter.config.${game} | grep -v '<!--.*-->' | sed -e "s/^.*<LauncherConfigurationServer>//;s/<\/LauncherConfigurationServer>.*$//"`
wget $wgetOptions "${launcherCfg_URL}" -O ${tempDir}/launcher.config
if ! [[ -s ${tempDir}/launcher.config ]] ; then
    echo -e "\nError: Could not fetch dynamic launcher configuration.\n"
    cd "$oldDir"
    read dummy
    exit
fi

# extract game settings from launcher settings
worldQueue_URL=`grep -h "WorldQueue.LoginQueue.URL" ${tempDir}/launcher.config | grep -v '<!--.*-->' | sed -e "s/^.*value=\"\([^\"]*\)\".*$/\1/"`
worldQueue_ARGTMPL=`grep -h "WorldQueue.TakeANumber.Parameters" ${tempDir}/launcher.config | grep -v '<!--.*-->' | sed -e "s/^.*value=\"\([^\"]*\)\".*$/\1/"`
gameClient_FILE=`grep -h "GameClient.WIN32.Filename" ${tempDir}/launcher.config | grep -v '<!--.*-->' | sed -e "s/^.*value=\"\([^\"]*\)\".*$/\1/"`
gameClient_ARGTMPL=`grep -h "GameClient.WIN32.ArgTemplate" ${tempDir}/launcher.config | grep -v '<!--.*-->' | sed -e "s/^.*value=\"\([^\"]*\)\".*$/\1/"`
dlFileList_URL=`grep -h "URL.DownloadFilesList" ${tempDir}/launcher.config | grep -v '<!--.*-->' | sed -e "s/^.*value=\"\([^\"]*\)\".*$/\1/"`
bug_URL=`grep -h "GameClient.Arg.bugurl" ${tempDir}/launcher.config | grep -v '<!--.*-->' | sed -e "s/^.*value=\"\([^\"]*\)\".*$/\1/"`
authServer_URL=`grep -h "GameClient.Arg.authserverurl" ${tempDir}/launcher.config | grep -v '<!--.*-->' | sed -e "s/^.*value=\"\([^\"]*\)\".*$/\1/"`
support_URL=`grep -h "GameClient.Arg.supporturl" ${tempDir}/launcher.config | grep -v '<!--.*-->' | sed -e "s/^.*value=\"\([^\"]*\)\".*$/\1/"`
supportService_URL=`grep -h "GameClient.Arg.supportserviceurl" ${tempDir}/launcher.config | grep -v '<!--.*-->' | sed -e "s/^.*value=\"\([^\"]*\)\".*$/\1/"`
glsTicketLifetime=`grep -h "GameClient.Arg.glsticketlifetime" ${tempDir}/launcher.config | grep -v '<!--.*-->' | sed -e "s/^.*value=\"\([^\"]*\)\".*$/\1/"`
crashReceiver=`grep -h "GameClient.Arg.crashreceiver" ${tempDir}/launcher.config | grep -v '<!--.*-->' | sed -e "s/^.*value=\"\([^\"]*\)\".*$/\1/"`
uploadThrottle=`grep -h "GameClient.Arg.DefaultUploadThrottleMbps" ${tempDir}/launcher.config | grep -v '<!--.*-->' | sed -e "s/^.*value=\"\([^\"]*\)\".*$/\1/"`

# extract list of game servers and settings
# this is a PITA without a proper parser:
#   grep for "<World>" and output 4 lines afterwards (which contain the server config)
#   then grep for "<Name>" and strip off any tags
# just the name is saved here, other info will be retrieved later on
worlds=`grep -h -A 4 "<World>" ${tempDir}/GLSDataCenter.config.${game} | grep "<Name>" | grep -v '<!--.*-->' | sed -e "s/^.*<Name>//;s/<\/Name>.*$//"`

# now we have a list of servernames, separated by new-line-characters, split them there into an array, ignore all other whitespace
IFS=$'\n'
i=0
for name in $worlds ; do
    serverNames[$i]=$name
    i=$(($i + 1))
done
serverNames[$i]="end-of-list"
unset IFS

# extract the auth server URL from the configuration file
authServer_URL=`grep -h "<AuthServer>" ${tempDir}/GLSDataCenter.config.${game} | grep -v '<!--.*-->' | sed -e "s/^.*<AuthServer>//;s/<\/AuthServer>.*$//"`
if [[ -z "${authServer_URL}" ]] ; then
    echo -e "\nError: Could not extract authentication server URL from launcher configuration.\n"
    cd "$oldDir"
    read dummy
    exit
fi


########### CHOOSE LANGUAGE (by Sinistral)

# get available languages
IFS=$'\n'
i=0
for name in $(ls -x1 *.dat | grep -h "client_local_" | sed -e "s/^.*client_local_//;s/.dat$//"); do
    # results are all upper case (EN, EN_GB, DE etc.)
    # for proper patching, the first two letters need to be lower case (en, en_GB, de etc.)
    # else the splash screen image will not get updated (Windows-dev's case-insensitivity sillyness, probably)
    languages[$i]=`echo ${name:0:2} | tr A-Z a-z`${name:2}
    i=$(($i + 1))
done
languages[$i]="end-of-list"
unset IFS

# is there even more than one language file? (mod by SNy)
if [[ $i > 1 ]] ; then
    # select the language
    echo -e "\nPlease choose your language now."
    i=0
    while [[ "${languages[$i]}" != "end-of-list" ]] ; do
        echo -e "\t$i:\t${languages[$i]}"
        i=$(($i + 1))
    done
    echo -n "Your choice (enter the number on the left)? "
    read selectedLanguage
else
    selectedLanguage=0
fi


########### PATCHING

function runPatch {
    if [[ -s lotrolauncher-patchprogress.script ]] ; then
        # patch progress script available, source it
        # then use it to monitor the patch progress
        . lotrolauncher-patchprogress.script
        patchProgressMonitor $@
    else
        # else just run the command as is
        $@
    fi
}

# default is NO patching
echo -en "\nDo you want to check for updates (y/N)? "
read checkForUpdates
if [[ $checkForUpdates == "y" || $checkForUpdates == "Y" ]] ; then
    echo "Checking for updates..."

    # NEW: also get the splash screens
    echo "Updating splash screens..."
    wget $wgetOptions "$dlFileList_URL" -O ${tempDir}/DownloadFilesList.xml
    langUC=`echo ${languages[$selectedLanguage]:0:2} | tr a-z A-Z`
    fileNames=`grep -h -A 4 "<File>" ${tempDir}/DownloadFilesList.xml | \
             grep -A 2 "<Description>${langUC}" | \
             grep -v '<!--.*-->' | \
             grep "<FileName>" | \
             sed -e "s/^.*<FileName>//;s/<\/FileName>.*$//" | \
             tr '\\\' '/'`
    dlUrls=`grep -h -A 4 "<File>" ${tempDir}/DownloadFilesList.xml | \
             grep -A 2 "<Description>${langUC}" | \
             grep -v '<!--.*-->' | \
             grep "<DownloadUrl>" | \
             sed -e "s/^.*<DownloadUrl>//;s/<\/DownloadUrl>.*$//"`
    IFS=$'\n'
    i=0
    for fileName in $fileNames ; do
        targetFiles[$i]="$fileName"
        i=$(($i + 1))
    done
    targetFiles[$i]="end-of-list"
    i=0
    for dlUrl in $dlUrls ; do
        sourceUrls[$i]="$dlUrl"
        i=$(($i + 1))
    done
    unset IFS
    i=0
    # NOTE: calling wget while IFS is set to $'\n' is... interesting!
    # hence, we do it after fiddling with those lines and resetting IFS
    while [[ "${targetFiles[$i]}" != "end-of-list" ]] ; do
        echo -en "\t${targetFiles[$i]}... "
        wget $wgetOptions "${sourceUrls[$i]}" -O "${targetFiles[$i]}"
        echo "Done."
        i=$(($i + 1))
    done

    # the actual patching is simple, thanks to Turbine, who have made the Patch()-function in the new PatchClient.dll very self explanatory
    # too bad finding this wasn't as obvious as using it (thanks again Robert Getter for pointing it out!)
    #
    # edit: regarding simplicity: OK, the patching itself takes place in a number of steps, download/decrypt file, replace file
    # some files require a "SelfPatch" others don't
    # this is yet to be understood properly, for now, just use the sequence below
    # NOTE: do NOT use a wine64 binary here, this fails with a rundll32 crash
    runPatch wine rundll32.exe PatchClient,Patch $patchServer_ADR --highres --filesonly --language ${languages[$selectedLanguage]} --productcode $game
    runPatch wine rundll32.exe PatchClient,Patch $patchServer_ADR --highres --dataonly  --language ${languages[$selectedLanguage]} --productcode $game
fi


########### AUTHENTICATION

function GLSAuth {
    # $1 would be the flag to keep the existing ticket
    if [[ $1 == "n" || $1 == "N" ]] ; then
        # account name
        echo -e "\nPlease enter your account details now."
        echo -n "account: "
        read account

        # password, read silently (no echo)
        echo -n "password: "
        read -s pass
        echo ""

        # "submit" the login form via POST, will download a file called "LoginAccount"
        # NOTE: the same thing as with the DataCenterServer applies here
        #       the lotroeugls server even has a service description and test form online
        #       well, at least they provide the SOAP request body as well...
        echo "Requesting GLS authentication ticket..."
        wget $wgetOptions \
            --header 'Content-Type: text/xml; charset=utf-8' \
            --header 'SOAPAction: "http://www.turbine.com/SE/GLS/LoginAccount"' \
            --post-data "<?xml version=\"1.0\" encoding=\"utf-8\"?><soap:Envelope xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\" xmlns:xsd=\"http://www.w3.org/2001/XMLSchema\" xmlns:soap=\"http://schemas.xmlsoap.org/soap/envelope/\"><soap:Body><LoginAccount xmlns=\"http://www.turbine.com/SE/GLS\"><username>${account}</username><password>${pass}</password><additionalInfo></additionalInfo></LoginAccount></soap:Body></soap:Envelope>" \
            "${authServer_URL}" -O ${tempDir}/GLSAuthServer.config
        if ! [[ -s ${tempDir}/GLSAuthServer.config ]] ; then
            echo -e "\nError: GLS auth server request failed. Wrong account/password?\n"
            echo -e "\nRetry (Y/n)? "
            read retry
            if [[ $retry == "y" || $retry == "Y" || $retry == "" ]] ; then
                GLSAuth $1
                return
            else
                cd "$oldDir"
                read dummy
                exit
            fi
        fi
    fi

    # check for multiple game subscriptions for the authenticated account
    # insert whitespace after </GameSubscription> tags here (to have linebreaks as separators for accounts)
    sed -e "s#\(</GameSubscription>\)#\1\n#g" ${tempDir}/GLSAuthServer.config > ${tempDir}/GLSAuthServer.config.whitespace
    # extract each of the ids as wells as descriptions for subscriptions to the current game
    subNames=`grep -h "<Game>${game}<\/Game>" ${tempDir}/GLSAuthServer.config.whitespace | grep "<Name>" | grep -v '<!--.*-->' | sed -e "s/^.*<Name>//;s/<\/Name>.*$//"`
    subDescs=`grep -h "<Game>${game}<\/Game>" ${tempDir}/GLSAuthServer.config.whitespace | grep "<Description>" | grep -v '<!--.*-->' | sed -e "s/^.*<Description>//;s/<\/Description>.*$//"`

    IFS=$'\n'
    # list of subscription ids and descriptions
    i=0
    for sub in $subNames ; do
        subs[$i]=$sub
        i=$(($i + 1))
    done
    subs[$i]="end-of-list"
    i=0
    for desc in $subDescs ; do
        descs[$i]=$desc
        i=$(($i + 1))
    done
    descs[$i]="end-of-list"
    unset IFS

    # check for at least one active subscription
    if [[ $i == 0 ]] ; then
        echo -e "\nError: There appears to be no subscription for $game.\n"
        cd "$oldDir"
        read dummy
        exit
    fi

    # if there are multiple subscriptions to the current game available for the account, ask which one to use
    if [[ $i > 1 ]] ; then
        i=0
        echo "You have the following subscriptions for $game:"
        while [[ "${subs[$i]}" != "end-of-list" ]] ; do
            echo -e "\t$i:\t${subs[$i]}\t'${descs[$i]}'"
            i=$(($i + 1))
        done
        echo -n "Please select the one you wish to use (enter the number on the left): "
        read selectedSub
    else
        selectedSub=0
    fi

    # extract the ticket from the GLS auth file, check for failure
    # NOTE: only the id (not the ticket) is subscription-specific
    glsTicket=`sed -n -e "s/^.*<Ticket>//;s/<\/Ticket>.*$// p" ${tempDir}/GLSAuthServer.config`
    if [[ -z "${glsTicket}" ]] ; then
        echo -e "\nError: Could not extract auth result from GLS auth server response.\n"
        cd "$oldDir"
        read dummy
        exit
    fi
    # the ticket can contain special characters and needs to be URL encoded before POSTing it
    glsTicketURLencoded=`echo "${glsTicket}" | sh urlencode.sh -- -`

    echo "Logged in."
}

# check if a ticket was acquired within the last 12 hours
useExistingTicket="N"
if [[ -s ${tempDir}/GLSAuthServer.config ]] ; then
    loginTimestamp=`stat -c "%Z" ${tempDir}/GLSAuthServer.config`
    now=`date +%s`
    secondsAgo=$(($now - $loginTimestamp))
    if [[ $secondsAgo -lt 43200 ]] ; then
        # acquired <12h ago, ask wether to try and re-use it
        echo -en "\nRe-use existing login ticket (Y/n)? "
        read useExistingTicket
    else
        # >12h ago, very likely expired, need to login
        echo -en "\nPrevious login ticket exists but has likely expired."
    fi
fi
# will only actually prompt if a new login is needed/requested
GLSAuth $useExistingTicket


########### REALM SELECTION

echo -e "\nThe following servers are available:"
i=0
while [[ "${serverNames[$i]}" != "end-of-list" ]] ; do
    echo -e "\t$i:\t${serverNames[$i]}"
    i=$(($i + 1))
done
echo -n "Your choice (enter the number on the left)? "
read selectedServer

# with the given index (and therefore server name), look up the server info in the configuration file
# chat server adress is given directly, other stuff needs another file (cache_$REALMNAME.xml) from the server
serverChat=`grep -h -A 4 "<World>" ${tempDir}/GLSDataCenter.config.${game} | grep -F -A 3  "${serverNames[$selectedServer]}" | grep -h "<ChatServerUrl>" | grep -v '<!--.*-->' | sed -e "s/^.*<ChatServerUrl>//;s/<\/ChatServerUrl>.*$//"`
serverStatus_URL=`grep -h -A 4 "<World>" ${tempDir}/GLSDataCenter.config.${game} | grep -F -A 3 "${serverNames[$selectedServer]}" | grep -h "<StatusServerUrl>" | grep -v '<!--.*-->' | sed -e "s/^.*<StatusServerUrl>//;s/<\/StatusServerUrl>.*$//"`

# now we know where the chat server resides and we have the adress of the server xml status file
# download the status file and get server adress and login queue adress to establish the connection
# ToDo: this file also contains current availability information, use it
wget $wgetOptions "$serverStatus_URL" -O ${tempDir}/server.config

# extract the list of loginServers and queue URLs (two at this time, it seems)
loginServers=`grep -h "<loginservers>" ${tempDir}/server.config | grep -v '<!--.*-->' | sed -e "s/^.*<loginservers>//;s/<\/loginservers>.*$//"`
queueUrls=`grep -h "<queueurls>" ${tempDir}/server.config | grep -v '<!--.*-->' | sed -e "s/^.*<queueurls>//;s/<\/queueurls>.*$//"`
if [[ -z "${loginServers}" ]] || [[ -z "${queueUrls}" ]] ; then
    echo -e "\nError: Could not extract server information for realm ${serverNames[$selectedServer]}.\n"
    cd "$oldDir"
    read dummy
    exit
fi

IFS=";"
i=0
for adr in $loginServers ; do
    serverAdresses[$i]=$adr
    i=$(($i + 1))
done
i=0
for adr in $queueUrls ; do
    serverQueues[$i]=$adr
    i=$(($i + 1))
done
unset IFS

# just use the respective first one given
serverAdress="${serverAdresses[0]}"
serverQueue="${serverQueues[0]}"

# just like the ticket above, the queue URL can contain special characters and needs to be URL encoded before POSTing it
loginQueueURLencoded=`echo "${serverQueue}" | sh urlencode.sh -- -`


########### LOGIN QUEUE / CLIENT START

function JoinQueue {

    # now get a queue number from the world login queue so that the client can enqueue and authenticate
    echo -e "\nConnecting to world login queue for realm ${serverNames[$selectedServer]}...";
    inQueue=1
    # loop when necessary
    while [[ "$inQueue" == "1" ]] ; do
        # launcher.config also includes a parameter template for the world queue request, used the same way as the client args below
        # NOTE: this request might fail with a re-tried login ticket, causing a new login below, which would update the ticket
        #       make sure to use the currently valid, encoded ticket for the current request
        worldQueue_ARGS=`echo "${worldQueue_ARGTMPL}" | sed -e "s/[{]0[}]/${subs[$selectedSub]}/;s/[{]1[}]/${glsTicketURLencoded}/;s/[{]2[}]/${loginQueueURLencoded}/;s/\&amp\;/\&/g"`
        wget $wgetOptions --post-data="${worldQueue_ARGS}" "${worldQueue_URL}" -O ${tempDir}/WorldQueue.config
        if ! [[ -s ${tempDir}/WorldQueue.config ]] ; then
            echo -e "\nError: World login queue request failed.\n"
            cd "$oldDir"
            read dummy
            exit
        fi

        # check the result, should be HRESULT 0x00000000, indicating success (Windows API madness)
        hresult=`grep -h "<HResult>" ${tempDir}/WorldQueue.config | grep -v '<!--.*-->' | sed -e "s/^.*<HResult>//;s/<\/HResult>.*$//"`
        if [[ "$hresult" != "0x00000000" ]] ; then
            echo -e "\nError: World login queue response indicates failure."
            # check the case of the re-tried login ticket and force a new login when the queue bailed
            if [[ $useExistingTicket == "y" || $useExistingTicket == "Y" ]] ; then
                echo "Existing login ticket rejected by server, you need to login again!"
                GLSAuth "N" # supply "N" to force relog, note that this will update the GLS ticket (see above)
            else
                echo -e "\nRetry? (Y/n)"
                read retry
                if [[ $retry == "n" || $retry == "N" ]] ; then
                    cd "$oldDir"
                    exit
                fi
            fi
        else
            # lets see what position we are at
            queuePos=`grep -h "<QueueNumber>" ${tempDir}/WorldQueue.config | grep -v '<!--.*-->' | sed -e "s/^.*<QueueNumber>//;s/<\/QueueNumber>.*$//"`
            queueSrvd=`grep -h "<NowServingNumber>" ${tempDir}/WorldQueue.config | grep -v '<!--.*-->' | sed -e "s/^.*<NowServingNumber>//;s/<\/NowServingNumber>.*$//"`
            queueAhead=$(( ${queuePos} - ${queueSrvd} ))
            if [[ ${queueAhead} -gt 0 ]] ; then
                # d'oh, need to wait
                echo -e "\n${queueAhead} ahead in queue, retrying in 5s..."
                sleep 5
            else
                # hah, ready to go
                inQueue=0
            fi
        fi
    done
}

# new: world queue is unused on (some?) EU servers, just like with DDO, skip if no queue URL
if [[ -n "${serverQueue}" ]] ; then
    JoinQueue
else
    echo -e "\nWorld login queue seems to be disabled, skipping..."
fi

# OK, so we have a template for the client arguments and we have the arguments
# note that for some replacements where the result can contain slashes (eg. for the glsTicket
# and the URLs), "s###" is used instead of "s///" to not confuse sed
# hopefully, it doesn't get confused by the sharp characters :)
gameClient_ARGS=`echo "${gameClient_ARGTMPL}" | sed "s/[{]SUBSCRIPTION[}]/${subs[$selectedSub]}/g;s#[{]LOGIN[}]#${serverAdress}#g;s#[{]CHAT[}]#${serverChat}#g;s#[{]GLS[}]#${glsTicket}#g;s/[{]LANG[}]/${languages[$selectedLanguage]}/g;s#[{]BUGURL[}]#${bug_URL}#g;s#[{]AUTHSERVERURL[}]#${authServer_URL}#g;s#[{]GLSTICKETLIFETIME[}]#${glsTicketLifetime}#g;s#[{]SUPPORTURL[}]#${support_URL}#g;s#[{]SUPPORTSERVICEURL[}]#${supportService_URL}#g;s#[{]CRASHRECEIVER[}]#${crashReceiver}#g;s/[{]UPLOADTHROTTLE[}]/${uploadThrottle}/g"`

# all ready, now fire up the client
echo "Ready. Now starting the client..."
${preWineCmds} $wineBinary ${wineOptions} ${gameClient_FILE} ${gameClient_ARGS} $@

# get back to where the caller was
cd "$oldDir"


########### THAT'S IT

# Permission granted to use and modify, as long as original copyleft notice is retained.
# CopyLeft (C) 2007-2014 SNy <SNy@SNy.name>
